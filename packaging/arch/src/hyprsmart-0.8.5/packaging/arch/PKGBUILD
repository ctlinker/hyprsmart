pkgname=hyprsmart
pkgver=0.8.5
pkgrel=1
pkgdesc="Adaptive transparency daemon for Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/ctlinker/hyprsmart"
license=('Apache-2.0')
depends=('glibc' 'hyprland' 'grim')
makedepends=('python' 'python-pip' 'python-pyinstaller' 'python-numpy' 'python-pillow' 'python-yaml')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    python -m PyInstaller \
        --clean \
        --noconfirm \
        --onedir \
        --name hyprsmart \
        --collect-all numpy \
        --collect-all PIL \
        --collect-all yaml \
        src/hyprsmart/__main__.py
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -dm755 "$pkgdir/opt/hyprsmart"
    cp -a dist/hyprsmart/. "$pkgdir/opt/hyprsmart/"

    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/hyprsmart/hyprsmart "$pkgdir/usr/bin/hyprsmart"
}