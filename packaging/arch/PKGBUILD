pkgname=hyprsmart
pkgver=0.8.6
pkgrel=1
pkgdesc="Adaptive transparency daemon for Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/ctlinker/hyprsmart"
license=('Apache-2.0')
depends=('glibc' 'hyprland' 'grim')
makedepends=('python' 'uv')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!strip')

build() {
    cd "$srcdir/$pkgname-$pkgver/hyprsmart"
    uv venv --clear
    uv sync
    uv run python -m PyInstaller \
        --clean \
        --noconfirm \
        --onedir \
        --name hyprsmart \
        --collect-all numpy \
        --collect-all PIL \
        --collect-all yaml \
        src/hyprsmart/__main__.py
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # 1. Install application files to /opt/hyprsmart
    install -dm755 "$pkgdir/opt/hyprsmart"
    cp -a hyprsmart/dist/hyprsmart/. "$pkgdir/opt/hyprsmart/"

    # 2. Create symlink in /usr/bin
    install -dm755 "$pkgdir/usr/bin"
    ln -s /opt/hyprsmart/hyprsmart "$pkgdir/usr/bin/hyprsmart"

    # 3. Install the systemd user service correctly
    install -Dm644 packaging/arch/hyprsmart.service "$pkgdir/usr/lib/systemd/user/hyprsmart.service"
}